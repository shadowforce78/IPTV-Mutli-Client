<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ApplicationId>com.CompanyName.IptvClient</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Git-ignored, machine-local: same real M3U playlist URL as the desktop head's
         appsettings.Local.json (see App.axaml.cs / Application.cs for how it's read — Android
         has no "next to the exe" location, so it's bundled as a raw asset instead). Condition
         keeps a fresh clone without this file building fine, same as the desktop head. -->
    <AndroidAsset Include="Assets\appsettings.Local.json" Condition="Exists('Assets\appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="VideoLAN.LibVLC.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IptvClient\IptvClient.csproj" />
  </ItemGroup>
</Project>
