<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- IPTV playlist/stream URLs are routinely plain http:// (third-party reseller panels,
	     not something this app controls) — Android blocks all cleartext traffic by default
	     since API 28, which is exactly what broke the very first playlist load attempt here
	     ("Connection failure" with no other detail). -->
	<application android:label="IPTV Multi-Client" android:icon="@drawable/Icon" android:banner="@drawable/banner" android:usesCleartextTraffic="true" />
</manifest>
