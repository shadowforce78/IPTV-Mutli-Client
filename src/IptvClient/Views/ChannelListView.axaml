<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:models="using:IptvClient.Core.Models"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="IptvClient.Views.ChannelListView"
             x:DataType="vm:ChannelListViewModel">
    <Grid ColumnDefinitions="240,16,*" Margin="12">
        <!-- Groups card -->
        <Border Grid.Column="0"
                Background="{StaticResource AppSurfaceBrush}"
                CornerRadius="12"
                Padding="6">
            <ListBox ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChannelGroup">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Channels card -->
        <Border Grid.Column="2"
                Background="{StaticResource AppSurfaceBrush}"
                CornerRadius="12"
                Padding="10">
            <DockPanel>
                <TextBox DockPanel.Dock="Top"
                         PlaceholderText="Rechercher…"
                         Text="{Binding SearchText}"
                         Background="{StaticResource AppSurfaceElevatedBrush}"
                         BorderThickness="0"
                         Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding Items}"
                         DoubleTapped="OnItemDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Channel">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="44" Height="44"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        Background="{StaticResource AppSurfaceElevatedBrush}"
                                        VerticalAlignment="Center">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding TvgLogo}"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GroupTitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
