<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:models="using:IptvClient.Core.Models"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="IptvClient.Views.ChannelListView"
             x:DataType="vm:ChannelListViewModel">
    <!-- Adaptive: side-by-side groups+items cards on a wide window (desktop), or a single
         drill-down panel at a time on a narrow one (phone portrait) — ChannelListView.axaml.cs
         measures its own width and sets IsNarrowLayout; everything else (which panel shows,
         column spans, the back button) is derived from that + IsShowingItems in the
         view-model, not decided here. -->
    <Grid Margin="4,12,4,16" RowDefinitions="Auto,*">
        <!-- Search bar is shared between both panels and both layouts, and "overrides" —
             typing a query jumps straight to filtered results even from the groups panel. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
            <Button Grid.Column="0"
                    Classes="transport icon"
                    Command="{Binding NavigateBackCommand}"
                    IsVisible="{Binding ShowBackButton}"
                    Background="{StaticResource AppSurfaceBrush}"
                    ToolTip.Tip="Retour">
                <Path Data="M11,3 L5,8 L11,13"
                      Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" />
            </Button>
            <TextBox Grid.Column="1"
                     PlaceholderText="Rechercher…"
                     Text="{Binding SearchText}"
                     BorderThickness="1" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="240,16,*">
            <!-- Groups card -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="{Binding GroupsColumnSpan}"
                    IsVisible="{Binding IsGroupsPanelVisible}"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <ListBox ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChannelGroup">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Channels card -->
            <Border Grid.Column="{Binding ItemsColumn}"
                    Grid.ColumnSpan="{Binding ItemsColumnSpan}"
                    IsVisible="{Binding IsItemsPanelVisible}"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding Items}"
                         DoubleTapped="OnItemDoubleTapped"
                         Tapped="OnItemTapped"
                         KeyDown="OnItemsKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Channel">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        Background="{StaticResource AppSurfaceElevatedBrush}"
                                        VerticalAlignment="Center">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding TvgLogo}"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GroupTitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
