<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:conv="using:IptvClient.Converters"
             mc:Ignorable="d" d:DesignWidth="1000"
             x:Class="IptvClient.Views.PlayerControlsView"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </UserControl.Resources>

    <!-- Hosted inside a Popup anchored to the video area (see MainView.axaml) — a genuine
         separate top-level window, not an Avalonia sibling of VideoView, since a native
         NativeControlHost surface always paints over any Avalonia content sharing its window
         ("airspace" — see MainView.axaml.cs). Fades via Opacity rather than collapsing so it
         never resizes the video underneath while toggling. The outer Margin makes it float
         as a card above the video's bottom edge instead of touching it. -->
    <Border Margin="16"
            Background="#E60E0E14"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="20,14"
            PointerMoved="OnPointerMoved"
            Opacity="{Binding IsControlsVisible, Converter={StaticResource BoolToOpacity}}"
            IsHitTestVisible="{Binding IsControlsVisible}">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="10">
            <SelectableTextBlock Text="{Binding StreamInfoText}"
                                 Foreground="{StaticResource AppTextSecondaryBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding StreamInfoText, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- Progress / seek bar -->
            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" VerticalAlignment="Center" FontSize="11" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds}"
                        IsEnabled="{Binding IsSeekable}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" VerticalAlignment="Center" FontSize="11" />
            </Grid>

            <!-- Transport controls + track/aspect pickers, grouped with thin dividers -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Classes="transport" Command="{Binding SkipBackCommand}" ToolTip.Tip="Reculer de 10 secondes">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M8,3 L4,8 L8,13 M13,3 L9,8 L13,13"
                              Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock Text="10" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Classes="transport icon" Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="Lecture / Pause">
                    <Panel Width="16" Height="16">
                        <Path Data="M4,3 L13,8 L4,13 Z" Fill="White" Stretch="Uniform" IsVisible="{Binding IsPaused}" />
                        <Path Data="M4,3 H6.5 V13 H4 Z M9.5,3 H12 V13 H9.5 Z" Fill="White" Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
                    </Panel>
                </Button>

                <Button Grid.Column="2" Classes="transport" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Avancer de 10 secondes">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="10" VerticalAlignment="Center" FontSize="12" />
                        <Path Data="M8,3 L12,8 L8,13 M3,3 L7,8 L3,13"
                              Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="3" Width="1" Height="24" Background="{StaticResource AppBorderBrush}" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding AudioTracks}"
                          SelectedItem="{Binding SelectedAudioTrack}"
                          PlaceholderText="Piste audio"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackOption">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="5"
                          ItemsSource="{Binding SubtitleTracks}"
                          SelectedItem="{Binding SelectedSubtitleTrack}"
                          PlaceholderText="Sous-titres"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackOption">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding AspectRatios}"
                          SelectedItem="{Binding SelectedAspectRatio}"
                          ToolTip.Tip="Ratio d'affichage"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AspectRatioOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Grid.Column="7" Width="1" Height="24" Background="{StaticResource AppBorderBrush}" />

                <Button Grid.Column="9" Classes="transport icon" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Couper / rétablir le son">
                    <Panel Width="16" Height="16">
                        <Path Data="M2,6 L5,6 L9,3 L9,13 L5,10 L2,10 Z" Fill="White" Stretch="Uniform" />
                        <Path Data="M10.5,5 L12.5,3 M10.5,8 L13.5,8 M10.5,11 L12.5,13"
                              Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"
                              Stretch="Uniform" IsVisible="{Binding IsUnmuted}" />
                        <Path Data="M10,5 L14,11 M14,5 L10,11"
                              Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"
                              Stretch="Uniform" IsVisible="{Binding IsMuted}" />
                    </Panel>
                </Button>

                <Slider Grid.Column="10"
                        Minimum="0" Maximum="100"
                        Value="{Binding Volume}"
                        VerticalAlignment="Center" />

                <Border Grid.Column="11" Width="1" Height="24" Background="{StaticResource AppBorderBrush}" />

                <Button Grid.Column="12" Classes="transport icon" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Plein écran">
                    <Panel Width="16" Height="16">
                        <Path Data="M2,7 L2,2 L7,2 M13,2 L18,2 L18,7 M18,13 L18,18 L13,18 M7,18 L2,18 L2,13"
                              Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform" IsVisible="{Binding IsWindowed}" />
                        <Path Data="M2,7 L7,7 L7,2 M13,2 L13,7 L18,7 M18,13 L13,13 L13,18 M7,18 L7,13 L2,13"
                              Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform" IsVisible="{Binding IsFullscreen}" />
                    </Panel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
