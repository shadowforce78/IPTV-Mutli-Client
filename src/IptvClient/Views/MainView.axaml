<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:views="using:IptvClient.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="IptvClient.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   Margin="8"
                   Opacity="0.7" />

        <TabControl>
            <TabItem Header="TV en direct">
                <views:ChannelListView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="Films &amp; Séries">
                <views:ChannelListView DataContext="{Binding Vod}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
