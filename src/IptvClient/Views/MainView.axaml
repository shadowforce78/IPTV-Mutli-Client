<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:views="using:IptvClient.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="IptvClient.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Index 0 (status) and 2/3 (splitter/tabs) are collapsed from code-behind
                 (MainView.axaml.cs) for fullscreen, leaving the video (1) to fill the window —
                 the control strip lives in a Popup anchored to it (below), not a row of its
                 own, so it never takes space away from the video either way. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,16,20,0" Spacing="8" IsVisible="{Binding ShowPlaylistBar}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="IPTV" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="PlaylistBox"
                         PlaceholderText="URL de la playlist M3U (http://… ou chemin de fichier)"
                         Text="{Binding PlaylistInput}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding LoadFromInputCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Classes="primary"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Content="Charger"
                        IsEnabled="{Binding !IsLoading}"
                        Command="{Binding LoadFromInputCommand}" />
            </Grid>

            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource AppTextSecondaryBrush}" />

                <TextBlock HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{StaticResource AppAccentBrush}"
                           IsVisible="{Binding CurrentChannel, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding CurrentChannel.Name, StringFormat='● {0}'}" />
            </Grid>
        </StackPanel>

        <!-- Video surface. VideoView is a NativeControlHost — a real native child window — so
             nothing Avalonia-rendered layered on top of it in the same Grid cell would ever
             actually be visible (the native content always wins that "airspace"). The control
             strip below is a Popup instead: a genuine separate top-level window, positioned to
             overlap this Border's bottom edge, which *can* paint over the native surface.

             VideoHost is an empty placeholder here — MainView.axaml.cs fills it with an actual
             LibVLCSharp.Avalonia.VideoView only when NOT running on Android. That control
             unconditionally sets MediaPlayer.Hwnd (a Windows/Linux/macOS-only concept); the
             Android build of LibVLCSharp.Shared doesn't have that member at all, so
             instantiating VideoView there is an instant MissingMethodException crash on
             launch, confirmed live on a physical device. Android needs its own video surface
             (libVLC's attachViews-on-a-native-View mechanism) — not built yet, tracked in
             CLAUDE.md. -->
        <Border Grid.Row="1"
                Name="VideoArea"
                Background="Black"
                MinHeight="200"
                Margin="20,0"
                IsVisible="{Binding IsPlayerVisible}"
                PointerMoved="OnVideoAreaPointerMoved">
            <ContentControl Name="VideoHost" />
        </Border>

        <Popup Name="ControlsPopup"
               PlacementTarget="{Binding #VideoArea}"
               Placement="AnchorAndGravity"
               PlacementAnchor="Bottom"
               PlacementGravity="Top"
               IsLightDismissEnabled="False"
               Width="{Binding #VideoArea.Bounds.Width}"
               IsOpen="{Binding IsControlsPopupOpen}">
            <views:PlayerControlsView />
        </Popup>

        <GridSplitter Grid.Row="2" Height="12" IsVisible="{Binding IsBrowserVisible}" HorizontalAlignment="Stretch" Background="Transparent" />

        <TabControl Grid.Row="3" Name="Tabs" IsVisible="{Binding IsBrowserVisible}">
            <TabItem Header="TV en direct">
                <views:ChannelListView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="Films &amp; Séries">
                <views:ChannelListView DataContext="{Binding Vod}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
