<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IptvClient.ViewModels"
             xmlns:views="using:IptvClient.Views"
             xmlns:conv="using:IptvClient.Converters"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="IptvClient.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Index 0 (status), 3 (splitter) and 4 (tabs) are collapsed from code-behind
                 (MainView.axaml.cs) for fullscreen — video (1) and the control strip (2) stay,
                 so playback stays controllable full-screen. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding StatusMessage}"
                   Margin="8"
                   Opacity="0.7" />

        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Right"
                   Margin="8"
                   Opacity="0.7"
                   IsVisible="{Binding CurrentChannel, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding CurrentChannel.Name, StringFormat='Lecture : {0}'}" />

        <!-- Video surface. VideoView is a NativeControlHost — a real native child window —
             so nothing Avalonia-rendered can be layered on top of it and actually be visible
             (the native content always wins that "airspace"); info and controls live in their
             own row below instead, not as an overlay. PointerMoved here still helps for the
             letterboxed edges (genuinely Avalonia-rendered), but movement directly over the
             video pixels needs the cursor-poll workaround in MainView.axaml.cs. -->
        <Border Grid.Row="1"
                Name="VideoArea"
                Background="Black"
                MinHeight="200"
                PointerMoved="OnVideoAreaPointerMoved">
            <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />
        </Border>

        <!-- Fading control strip: stream info + progress + transport. Fixed height (fades via
             Opacity, doesn't collapse) so hiding it never resizes — and therefore never
             resizes — the video row above. -->
        <Border Grid.Row="2"
                Background="#141414"
                Padding="12,8"
                PointerMoved="OnVideoAreaPointerMoved"
                Opacity="{Binding IsControlsVisible, Converter={StaticResource BoolToOpacity}}"
                IsHitTestVisible="{Binding IsControlsVisible}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>

            <StackPanel Spacing="6">
                <SelectableTextBlock Text="{Binding StreamInfoText}"
                                     Foreground="#CCFFFFFF"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding StreamInfoText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Progress / seek bar -->
                <Grid ColumnDefinitions="44,*,44" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" VerticalAlignment="Center" FontSize="11" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds}"
                            IsEnabled="{Binding IsSeekable}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" VerticalAlignment="Center" FontSize="11" />
                </Grid>

                <!-- Transport controls + track pickers -->
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Classes="transport" Command="{Binding SkipBackCommand}" ToolTip.Tip="Reculer de 10 secondes">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="M8,3 L4,8 L8,13 M13,3 L9,8 L13,13"
                                  Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="10" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Classes="transport" Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="Lecture / Pause">
                        <Panel Width="16" Height="16">
                            <Path Data="M4,3 L13,8 L4,13 Z" Fill="White" Stretch="Uniform" IsVisible="{Binding IsPaused}" />
                            <Path Data="M4,3 H6.5 V13 H4 Z M9.5,3 H12 V13 H9.5 Z" Fill="White" Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>

                    <Button Grid.Column="2" Classes="transport" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Avancer de 10 secondes">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="10" VerticalAlignment="Center" FontSize="12" />
                            <Path Data="M8,3 L12,8 L8,13 M3,3 L7,8 L3,13"
                                  Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </StackPanel>
                    </Button>

                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding AudioTracks}"
                              SelectedItem="{Binding SelectedAudioTrack}"
                              PlaceholderText="Piste audio"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding SubtitleTracks}"
                              SelectedItem="{Binding SelectedSubtitleTrack}"
                              PlaceholderText="Sous-titres"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="6" Classes="transport" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Couper / rétablir le son">
                        <Panel Width="16" Height="16">
                            <Path Data="M2,6 L5,6 L9,3 L9,13 L5,10 L2,10 Z" Fill="White" Stretch="Uniform" />
                            <Path Data="M10.5,5 L12.5,3 M10.5,8 L13.5,8 M10.5,11 L12.5,13"
                                  Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"
                                  Stretch="Uniform" IsVisible="{Binding IsUnmuted}" />
                            <Path Data="M10,5 L14,11 M14,5 L10,11"
                                  Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"
                                  Stretch="Uniform" IsVisible="{Binding IsMuted}" />
                        </Panel>
                    </Button>

                    <Slider Grid.Column="7"
                            Minimum="0" Maximum="100"
                            Value="{Binding Volume}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8"
                               Text="{Binding Volume}"
                               VerticalAlignment="Center"
                               Width="28" />

                    <Button Grid.Column="9" Classes="transport" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Plein écran">
                        <Panel Width="16" Height="16">
                            <Path Data="M2,7 L2,2 L7,2 M13,2 L18,2 L18,7 M18,13 L18,18 L13,18 M7,18 L2,18 L2,13"
                                  Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  Stretch="Uniform" IsVisible="{Binding IsWindowed}" />
                            <Path Data="M2,7 L7,7 L7,2 M13,2 L13,7 L18,7 M18,13 L13,13 L13,18 M7,18 L7,13 L2,13"
                                  Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  Stretch="Uniform" IsVisible="{Binding IsFullscreen}" />
                        </Panel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#33FFFFFF" />

        <TabControl Grid.Row="4">
            <TabItem Header="TV en direct">
                <views:ChannelListView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="Films &amp; Séries">
                <views:ChannelListView DataContext="{Binding Vod}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
