<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IptvClient"
             x:Class="IptvClient.App"
             RequestedThemeVariant="Dark">
             <!-- Forced dark rather than following the system theme — video content and a
                  dark player chrome go together regardless of the user's OS preference,
                  same call most media apps make. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Design tokens — the app's own palette on top of FluentTheme's dark defaults.
             Kept separate from FluentTheme's own SystemAccentColor etc. (not overridden)
             so built-in control theming stays untouched; these are only pulled in by our
             own styles/views below. -->
        <Color x:Key="AppBackgroundColor">#08080C</Color>
        <Color x:Key="AppSurfaceColor">#131319</Color>
        <Color x:Key="AppSurfaceElevatedColor">#1D1D26</Color>
        <Color x:Key="AppBorderColor">#26262F</Color>
        <Color x:Key="AppAccentColor">#7C6CFF</Color>
        <Color x:Key="AppAccentMutedColor">#2A2650</Color>
        <Color x:Key="AppTextSecondaryColor">#8E8EA3</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
        <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource AppSurfaceElevatedColor}" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
        <SolidColorBrush x:Key="AppAccentMutedBrush" Color="{StaticResource AppAccentMutedColor}" />
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Rounded, evenly padded rows everywhere lists are used (channel groups, channels,
             track pickers) instead of FluentTheme's default edge-to-edge rectangle. -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentMutedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentMutedBrush}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Accent "primary" button (Charger) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#9488FF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <Style Selector="Slider /template/ Track#PART_Track Thumb">
            <Setter Property="Background" Value="White" />
        </Style>

        <!-- Segmented pill tabs instead of Fluent's underline tabs -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="16,4,16,0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
        </Style>
        <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TabItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentMutedBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Flat, borderless "transport" buttons for the video overlay control bar — icon or
             icon+label content, no default Button chrome. Hover/pressed feedback still comes
             from FluentTheme's own Button states, this only resets the idle look. -->
        <Style Selector="Button.transport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Icon-only transport buttons (play/pause, mute, fullscreen): fixed circular
             footprint so they line up evenly with each other regardless of their icon. -->
        <Style Selector="Button.transport.icon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
    </Application.Styles>
</Application>
